{
  "name": "tiktok-extension",
  "displayName": "Tiktok extension",
  "version": "0.0.1",
  "description": "tiktok extension",
  "author": "stefan",
  "scripts": {
    "dev": "plasmo dev",
    "build": "plasmo build",
    "package": "plasmo package",
    "dev:ff": "plasmo dev --target=firefox-mv3",
    "build:ff": "plasmo build --target=firefox-mv3",
    "package:ff": "plasmo package --target=firefox-mv3"
  },
  "dependencies": {
    "@plasmohq/messaging": "^0.7.2",
    "@plasmohq/storage": "^1.15.0",
    "firebase": "^12.6.0",
    "lucide-react": "^0.553.0",
    "plasmo": "0.90.5",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "tailwindcss": "3.4.1"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "4.1.1",
    "@types/chrome": "0.0.258",
    "@types/node": "20.11.5",
    "@types/react": "18.2.48",
    "@types/react-dom": "18.2.18",
    "postcss": "8.4.33",
    "prettier": "3.2.4",
    "typescript": "5.3.3"
  },
  "manifest": {
    "host_permissions": [
      "https://*.tiktok.com/*",
      "http://49.13.217.93:9000/*",
      "https://adloops.ai/*"
    ],
    "permissions": [
      "downloads"
    ],
    "browser_specific_settings": {
      "gecko": {
        "id": "razdir97@gmail.com",
        "strict_min_version": "109.0"
      }
    }
  }
}